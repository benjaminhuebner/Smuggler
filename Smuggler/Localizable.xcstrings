{
  "sourceLanguage": "en",
  "strings": {
    "%@ belongs to macOS": {
      "comment": "Error: path is in a protected system location",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ gehört zu macOS"
          }
        }
      }
    },
    "%@ can't be used": {
      "comment": "Error: URL is not a valid file URL",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ kann nicht verwendet werden"
          }
        }
      }
    },
    "%@ could not be changed": {
      "comment": "Error: unexpected system error",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ konnte nicht geändert werden"
          }
        }
      }
    },
    "%@ could not be found": {
      "comment": "Error: file does not exist",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ wurde nicht gefunden"
          }
        }
      }
    },
    "%@ is a link, not a file": {
      "comment": "Error: the item is a symbolic link",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ist eine Verknüpfung, keine Datei"
          }
        }
      }
    },
    "%@ is ready to use.": {
      "comment": "Notification body: single file success",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ist einsatzbereit."
          }
        }
      }
    },
    "%@ took too long": {
      "comment": "Error: operation took too long",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ hat zu lange gedauert"
          }
        }
      }
    },
    "%@ was not in quarantine.": {
      "comment": "Notification body: the single item had no quarantine to remove",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ war nicht in Quarantäne."
          }
        }
      }
    },
    "%lld already free, %lld failed": {
      "comment": "Status bar: nothing freed, some had no quarantine, some failed",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld bereits frei, %lld fehlgeschlagen"
          }
        }
      }
    },
    "%lld freed, %lld already free": {
      "comment": "Status bar: some freed, some had no quarantine",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld freigegeben, %lld bereits frei"
          }
        }
      }
    },
    "%lld freed, %lld could not be processed": {
      "comment": "File row status: partial success with counts",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld freigegeben, %lld nicht verarbeitet"
          }
        }
      }
    },
