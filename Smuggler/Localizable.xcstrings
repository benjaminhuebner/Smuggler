      "comment": "Confirm dialog body: warn about an external quarantine-removal request",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fahre nur fort, wenn du das selbst gestartet hast.\n\n%@"
