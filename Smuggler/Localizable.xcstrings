        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Quarantäne aufgehoben"
          }
        }
      }
    },
    "Quarantine sits on the item the link points at. Drag that one in instead.": {
      "comment": "Error recovery: the item is a symbolic link",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Quarantäne sitzt auf dem Objekt, auf das die Verknüpfung zeigt. Zieh dieses stattdessen herein."
          }
        }
      }
    },
    "Quarantine was removed. Only open items you trust.": {
      "comment": "Confirm dialog body: warn before opening files after quarantine removal",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Quarantäne wurde entfernt. Öffne nur Objekte, denen du vertraust."
          }
