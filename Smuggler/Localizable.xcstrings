      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "1 Objekt freigegeben"
          }
        }
      }
    },
    "1 item freed from quarantine.": {
      "comment": "Error popover: exactly one item was freed",
