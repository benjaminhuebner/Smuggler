      "comment": "File row status: had no quarantine",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "War nicht in Quarantäne – nichts zu tun"
          }
        }
      }
    },
    "Nothing needed freeing": {
      "comment": "Status bar: nothing had quarantine to remove",
