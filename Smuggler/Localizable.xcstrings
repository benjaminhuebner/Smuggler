            "state": "translated",
            "value": "Verarbeitung …"
          }
        }
      }
    },
    "Quarantine Partially Removed": {
      "comment": "Notification title: partial success",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Quarantäne teilweise aufgehoben"
          }
        }
      }
    },
    "Quarantine Removal Failed": {
      "comment": "Notification title: failure",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Quarantäne konnte nicht aufgehoben werden"
