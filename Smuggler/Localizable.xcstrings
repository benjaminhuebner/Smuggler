      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle abbrechen"
          }
        }
      }
    },
    "Cancel all in-flight items": {
      "comment": "Help tag for the Cancel All button",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle laufenden Vorgänge abbrechen"
