    "It may have been moved or deleted. Drag it in again from where it is now.": {
      "comment": "Error recovery: file is gone",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sie wurde vielleicht verschoben oder gelöscht. Zieh sie noch einmal von ihrem jetzigen Ort herein."
          }
        }
      }
    },
    "Items still in progress will be left as they are.": {
      "comment": "Alert body: quitting with work in flight",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Objekte, die gerade laufen, bleiben unverändert."
          }
        }
      }
    },
    "No items could be freed": {
      "comment": "Status bar: nothing succeeded",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keine Objekte konnten freigegeben werden"
