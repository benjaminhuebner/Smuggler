    "Removing quarantine…": {
      "comment": "Compact status: processing",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Quarantäne wird aufgehoben …"
          }
        }
      }
    },
    "Select the file in Finder and press Command-I. Under “Sharing & Permissions”, give your account read & write access, then try again.": {
      "comment": "Error recovery: how to grant write permission in Finder",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähl die Datei im Finder aus und drück Befehl-I. Gib deinem Benutzer unter „Freigabe & Zugriffsrechte“ Lese- und Schreibrechte und versuch es dann noch einmal."
          }
        }
      }
    },
    "Show error details": {
      "comment": "Accessibility action: open the error popover",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fehlerdetails anzeigen"
          }
        }
      }
    },
    "Show in Finder": {
      "comment": "Accessibility label: reveal the file in Finder",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Im Finder zeigen"
          }
        }
      }
    },
    "Smuggler": {
      "comment": "Brand name — do not translate.",
      "shouldTranslate": false
    },
    "Smuggler never changes files in protected system folders.": {
      "comment": "Error recovery: protected system location",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Smuggler ändert niemals Dateien in geschützten Systemordnern."
          }
        }
      }
    },
    "The files in this folder were skipped. Check that you can open it in Finder, then try again.": {
      "comment": "Error recovery: folder could not be descended into",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
